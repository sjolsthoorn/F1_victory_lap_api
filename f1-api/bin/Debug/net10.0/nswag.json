{
  "$schema": "http://json.schemastore.org/nswag",
  "runtime": "Net80",
  "documentGenerator": {
    "fromDocument": {
      "url": "http://localhost:5241/swagger/v1/swagger.json"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "{controller}Service",
      "template": "Angular",
      "promiseType": "Promise",
      "httpClass": "HttpClient",
      "useRxJs": true,
      "rxJsVersion": 7.0,
      "dateTimeType": "string",
      "nullValue": "Undefined",
      "generateClientClasses": true,
      "generateClientInterfaces": true,
      "generateOptionalParameters": false,
      "markOptionalProperties": true,
      "typeStyle": "Class",
      "generateDefaultValues": true,
      "output": "../../f1/src/app/api/services.ts"
    }
  }
}
